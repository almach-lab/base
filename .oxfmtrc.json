{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/dist",
    "**/.astro",
    "**/coverage",
    "**/.turbo",
    "**/*.min.js",
    "apps/docs/public/llms-ui-api.snapshot.json",
    "~/"
  ]
}
