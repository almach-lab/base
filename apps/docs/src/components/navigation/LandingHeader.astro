---
import { ArrowRight, ExternalLink, Github, Menu } from "lucide-react";

import HeaderBrand from "../HeaderBrand.astro";
import { ThemeModeToggle } from "../ThemeModeToggle";
import { isNavItemActive, LANDING_NAV_ITEMS } from "./nav-items";

const { currentPath } = Astro.props as { currentPath: string };

const iconButtonClass =
  "flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent/80 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
const navLinkClass = (href: string) =>
  `rounded-md px-2.5 py-1.5 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${
    isNavItemActive(currentPath, href)
      ? "text-foreground"
      : "text-muted-foreground hover:text-foreground"
  }`;
const shellClass =
  "mx-auto flex h-14 w-full max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8";
---

<div class={shellClass}>
  <HeaderBrand />

  <div class="flex items-center gap-1 sm:gap-2">
    <details class="relative lg:hidden">
      <summary
        class={`${iconButtonClass} list-none [&::-webkit-details-marker]:hidden`}
        aria-label="Open navigation menu"
      >
        <Menu className="h-4 w-4" aria-hidden="true" />
      </summary>

      <div class="absolute right-0 top-full z-50 mt-2 w-52 rounded-lg border border-border bg-background p-1.5 shadow-lg">
        {LANDING_NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class={`${navLinkClass(item.href)} block px-3 py-2`}
            aria-current={isNavItemActive(currentPath, item.href) ? "page" : undefined}
          >
            {item.name}
          </a>
        ))}

        <div class="my-1 h-px bg-border" aria-hidden="true"></div>

        <a
          href="/getting-started"
          class="flex items-center rounded-md px-3 py-2 text-sm font-medium text-foreground transition-colors hover:bg-accent"
        >
          Get Started
          <ArrowRight className="ml-auto h-3.5 w-3.5 opacity-70" aria-hidden="true" />
        </a>

        <a
          href="https://github.com/almach-lab/base"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
        >
          GitHub
          <ExternalLink className="ml-auto h-3.5 w-3.5 opacity-60" aria-hidden="true" />
        </a>
      </div>
    </details>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Landing navigation">
      {LANDING_NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class={navLinkClass(item.href)}
          aria-current={isNavItemActive(currentPath, item.href) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
    </nav>

    <a
      href="/getting-started"
      class="hidden items-center gap-1.5 rounded-md border border-border bg-background px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:bg-accent sm:inline-flex"
    >
      Get started
      <ArrowRight className="h-3.5 w-3.5 opacity-70" aria-hidden="true" />
    </a>

    <ThemeModeToggle client:load />

    <a
      href="https://github.com/almach-lab/base"
      target="_blank"
      rel="noopener noreferrer"
      class={`hidden sm:flex ${iconButtonClass}`}
      aria-label="GitHub"
    >
      <Github className="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</div>
