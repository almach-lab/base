---
import { Menu } from "lucide-react";
import { docsLayout } from "../../lib/docs-layout";
import { getDocsPackageForPath } from "../../lib/docs-package";
import { PackageBreadcrumb } from "../docs/package-breadcrumb";
import HeaderBrand from "../HeaderBrand.astro";
import { MobileMoreMenu } from "../MobileMoreMenu";
import { SearchCommand } from "../SearchCommand";
import { ThemeModeToggle } from "../ThemeModeToggle";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const headerPackage = getDocsPackageForPath(currentPath);

const iconButtonClass =
  "flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent/50 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
---

<div class={docsLayout.header}>
  <div class={docsLayout.headerBrand}>
    <button
      id="sidebar-toggle"
      class:list={[iconButtonClass, "lg:hidden"]}
      aria-label="Toggle sidebar"
      aria-controls="mobile-sidebar"
      onclick="window.dispatchEvent(new CustomEvent('almach-sidebar-toggle'))"
    >
      <Menu className="h-4 w-4" aria-hidden="true" />
    </button>
    <HeaderBrand />
  </div>

  <div class={docsLayout.headerMeta}>
    <PackageBreadcrumb pkg={headerPackage} size="sm" />
  </div>

  <div class={docsLayout.headerActions}>
    <SearchCommand client:load />
    <ThemeModeToggle client:load />
    <MobileMoreMenu client:load />
  </div>
</div>
