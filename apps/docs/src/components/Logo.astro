---
import { BRAND_LOGO_FILL, BRAND_LOGO_PATH } from "../lib/branding";

interface Props {
  class?: string;
  /** Override the mark colour. Pass `"currentColor"` to inherit text colour. */
  fill?: string;
}

const { class: className, fill = BRAND_LOGO_FILL } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 3000 3000"
  class={className}
  role="img"
  aria-hidden="true"
>
  <path fill={fill} d={BRAND_LOGO_PATH}></path>
</svg>
