---
import "../styles/globals.css";
import { ClientRouter } from "astro:transitions";

import { DocSidebar } from "../components/DocSidebar";
import Logo from "../components/Logo.astro";
import DocsHeader from "../components/navigation/DocsHeader.astro";
import LandingHeader from "../components/navigation/LandingHeader.astro";
import { OnThisPage } from "../components/OnThisPage";
import {
  BRAND_DEFAULT_DESCRIPTION,
  BRAND_NAME,
  formatPageTitle,
  getBrandLicenseText,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  resolveSiteUrl,
} from "../lib/branding";
import { docsLayout } from "../lib/docs-layout";

const {
  title = BRAND_NAME,
  description = BRAND_DEFAULT_DESCRIPTION,
  currentPath = Astro.url.pathname,
  ogImage = "/og.png",
} = Astro.props;

const siteUrl = resolveSiteUrl(Astro.site);
const canonicalUrl = `${siteUrl}${currentPath}`;
const pageTitle = formatPageTitle(title);
const ogImageUrl = `${siteUrl}${ogImage}`;
const licenseText = getBrandLicenseText();

const isHome = currentPath === "/";
const landingMainClass = "flex-1";
const footerContainerClass =
  "mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-4 px-5 py-5 text-xs text-muted-foreground sm:flex-row lg:px-8";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      (() => {
        const root = document.documentElement;

        const applyStoredTheme = () => {
          try {
            const storedMode = localStorage.getItem("theme");
            const isDark = storedMode
              ? storedMode === "dark"
              : root.classList.contains("dark");
            root.classList.toggle("dark", isDark);

            const raw = localStorage.getItem("almach-theme");
            if (!raw) {
              window.dispatchEvent(
                new CustomEvent("almach-theme-mode-changed"),
              );
              return;
            }

                        const theme = JSON.parse(raw);
            const surface = theme?.surfaceTokens;

            if (surface) {
              root.style.setProperty("--background", isDark ? surface.backgroundDark : surface.backgroundLight);
              root.style.setProperty("--foreground", isDark ? surface.foregroundDark : surface.foregroundLight);
              root.style.setProperty("--card", isDark ? surface.cardDark : surface.cardLight);
              root.style.setProperty("--card-foreground", isDark ? surface.cardForegroundDark : surface.cardForegroundLight);
              root.style.setProperty("--muted", isDark ? surface.mutedDark : surface.mutedLight);
              root.style.setProperty("--muted-foreground", isDark ? surface.mutedForegroundDark : surface.mutedForegroundLight);
              root.style.setProperty("--accent", isDark ? surface.accentDark : surface.accentLight);
              root.style.setProperty("--accent-foreground", isDark ? surface.accentForegroundDark : surface.accentForegroundLight);
              root.style.setProperty("--border", isDark ? surface.borderDark : surface.borderLight);
              root.style.setProperty("--input", isDark ? surface.inputDark : surface.inputLight);
              root.style.setProperty("--secondary", isDark ? surface.accentDark : surface.accentLight);
              root.style.setProperty("--secondary-foreground", isDark ? surface.accentForegroundDark : surface.accentForegroundLight);
            }

            const status = theme?.statusTokens;
            if (status) {
              root.style.setProperty("--success", isDark ? status.successDark : status.successLight);
              root.style.setProperty("--success-foreground", isDark ? status.successForegroundDark : status.successForegroundLight);
              root.style.setProperty("--warning", isDark ? status.warningDark : status.warningLight);
              root.style.setProperty("--warning-foreground", isDark ? status.warningForegroundDark : status.warningForegroundLight);
              root.style.setProperty("--destructive", isDark ? status.destructiveDark : status.destructiveLight);
              root.style.setProperty("--destructive-foreground", isDark ? status.destructiveForegroundDark : status.destructiveForegroundLight);
            }

            const activePrimary = isDark ? theme?.primaryDark : theme?.primaryLight;
            if (activePrimary) {
              root.style.setProperty("--primary", activePrimary);
              root.style.setProperty("--ring", activePrimary);
            }

            if (theme?.radius) {
              root.style.setProperty("--radius", theme.radius);
            }
            if (typeof theme?.overlayMs === "number") {
              root.style.setProperty("--theme-motion-overlay-duration-ms", String(theme.overlayMs));
              root.style.setProperty("--theme-motion-overlay-duration", `${theme.overlayMs}ms`);
            }
            if (typeof theme?.interactiveMs === "number") {
              root.style.setProperty("--theme-motion-interactive-duration", `${theme.interactiveMs}ms`);
            }
            if (theme?.ease) {
              root.style.setProperty("--theme-motion-ease-standard", theme.ease);
            }
          } catch {
            // noop
          }

          window.dispatchEvent(new CustomEvent("almach-theme-mode-changed"));
        };

        if (!window.__almachApplyTheme) {
          window.__almachApplyTheme = applyStoredTheme;
          document.addEventListener(
            "astro:before-swap",
            window.__almachApplyTheme,
          );
          document.addEventListener(
            "astro:after-swap",
            window.__almachApplyTheme,
          );
        }

        window.__almachApplyTheme();
      })();
    </script>
  </head>

  <body class="bg-background font-sans text-foreground antialiased">
    {
      isHome ? (
        <div class="flex min-h-screen flex-col">
          <header class="sticky top-0 z-40 border-b border-border/40 bg-background/90 backdrop-blur-md">
            <LandingHeader currentPath={currentPath} />
          </header>

          <main class={landingMainClass} id="main-content" transition:name="page-content">
            <slot />
          </main>

          <footer class="mt-auto border-t border-border/40">
            <div class={footerContainerClass}>
              <div class="flex items-center gap-2">
                <Logo class="h-4 w-4" />
                {licenseText}
              </div>
              <div class="text-center sm:text-right">
                Built with React · Astro · Tailwind CSS v4
              </div>
            </div>
          </footer>
        </div>
      ) : (
        <div class={docsLayout.pageRoot}>
          <header class={docsLayout.pageHeader}>
            <DocsHeader currentPath={currentPath} />
          </header>

          <div class={docsLayout.shell}>
            <DocSidebar
              currentPath={currentPath}
              client:load
              transition:persist="doc-sidebar"
            />

            <main
              class={docsLayout.main}
              id="main-content"
              transition:name="page-content"
            >
              <div class={docsLayout.content}>
                <slot />
              </div>

              <footer class={docsLayout.mainFooter}>
                <div class="flex items-center gap-2">
                  <Logo class="h-4 w-4" />
                  {licenseText}
                </div>
                <div class="text-center sm:text-right">
                  Built with React · Astro · Tailwind CSS v4
                </div>
              </footer>
            </main>

            <aside class={docsLayout.toc}>
              <OnThisPage client:load />
            </aside>
          </div>

          <footer class={docsLayout.globalFooter}>
            <div class={footerContainerClass}>
              <div class="flex items-center gap-2">
                <Logo class="h-4 w-4" />
                {licenseText}
              </div>
              <div class="text-center sm:text-right">
                Built with React · Astro · Tailwind CSS v4
              </div>
            </div>
          </footer>
        </div>
      )
    }
  </body>
</html>
